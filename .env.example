# ----------------------------------------------------------------------------
# Horos Viewer — environment variables
# Copy to `.env` and fill in. `.env` is gitignored.
# ----------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# Auth / sessions ------------------------------------------------------------
# REQUIRED. Secret used to sign session JWTs (HS256). Must be a strong random
# string of at least 16 characters — the server refuses to start sessions with
# a weak/empty value. Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Manus OAuth (login provider)
VITE_APP_ID=
OAUTH_SERVER_URL=
# openId of the account that should be bootstrapped as the first admin
OWNER_OPEN_ID=

# Database (MySQL) -----------------------------------------------------------
# REQUIRED for any patient-data feature. Format:
# mysql://user:password@host:3306/database
DATABASE_URL=

# Object storage (Forge presigned S3) ----------------------------------------
# REQUIRED to upload/serve DICOM files.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Orthanc PACS (optional) ----------------------------------------------------
ORTHANC_URL=http://localhost:8042
ORTHANC_USER=
ORTHANC_PASSWORD=

# SMTP email notifications (optional) ----------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@horos-viewer.com
