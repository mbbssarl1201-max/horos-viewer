# ----------------------------------------------------------------------------
# Horos Viewer — environment variables
# Copy to `.env` and fill in. `.env` is gitignored.
# ----------------------------------------------------------------------------

# Runtime
NODE_ENV=production
PORT=3000

# Deployment domain (used by Traefik in docker-compose.yml)
HOROS_DOMAIN=horos.example.com

# Auth / sessions ------------------------------------------------------------
# REQUIRED. Secret used to sign session JWTs (HS256). Must be a strong random
# string of at least 16 characters. Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Auth mode: "local" = self-hosted email/password (default). The first account
# registered becomes admin. Set to anything else to use Manus OAuth instead.
AUTH_MODE=local
# Frontend equivalent (must match AUTH_MODE for the login UI to behave).
VITE_AUTH_MODE=local

# Manus OAuth (ONLY if AUTH_MODE != local) -----------------------------------
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# VITE_OAUTH_PORTAL_URL=

# Database (MySQL) -----------------------------------------------------------
# REQUIRED. With docker-compose, host is the `db` service.
# mysql://user:password@host:3306/database
DATABASE_URL=mysql://horos:CHANGE_ME@db:3306/horos
# Used by the bundled MySQL container (docker-compose.yml):
MYSQL_DATABASE=horos
MYSQL_USER=horos
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

# Object storage (S3-compatible / MinIO) -------------------------------------
# REQUIRED to upload/serve DICOM. With docker-compose, endpoint is the `minio`
# service on the internal network.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=horos-dicom
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# Orthanc PACS (optional) ----------------------------------------------------
ORTHANC_URL=http://localhost:8042
ORTHANC_USER=
ORTHANC_PASSWORD=

# SMTP email notifications (optional) ----------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@horos-viewer.com

# Analyse IA d'imagerie ------------------------------------------------------
# Backend : "ollama" (LOCAL, PHI-safe, DÉFAUT) ou "claude" (Anthropic cloud US).
AI_BACKEND=ollama
OLLAMA_URL=http://ollama-hermes:11434
# URL Ollama dédiée à la VISION (GPU L4 Infomaniak via tunnel chiffré). Si non
# défini, retombe sur OLLAMA_URL. La vision est le seul appel qui exige le GPU.
# OLLAMA_VISION_URL=http://ollama-hermes:11434
# Modèle vision principal (compte rendu d'imagerie). Défaut code = qwen2.5vl:7b
# (nettement plus fiable que le 3b pour le médical ; tient dans 24 Go VRAM).
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# 2e modèle vision pour la "double lecture" (avis indépendant oui/non) : on prend
# volontairement un modèle PLUS LÉGER et DIFFÉRENT pour détecter les désaccords.
OLLAMA_VISION_MODEL2=qwen2.5vl:3b
# Modèle texte Ollama pour le chat « Hermès radiologue » (local, PHI-safe).
# Défaut code = qwen2.5:3b ; le GPU MBBS héberge aussi qwen2.5:14b (plus fin).
OLLAMA_TEXT_MODEL=qwen2.5:3b
# Modèle d'embeddings Ollama pour la base de connaissances Hermès (local, PHI-safe).
OLLAMA_EMBED_MODEL=nomic-embed-text
# Moteur de GÉNÉRATION DE CR (pré-analyse) : auto (défaut : Infomaniak CH
# prioritaire dès que sa clé est présente) | claude (router le CR vers Claude —
# ex. Fable 5 — sans retirer Infomaniak des autres chemins vision) | infomaniak.
# CR_PROVIDER=auto
# ANTHROPIC_API_KEY=
# Modèle Claude. Défaut = claude-opus-4-8. Alternative = claude-fable-5 (le plus
# capable ; thinking toujours actif ; ~10$/50$ par M tokens).
# ANTHROPIC_MODEL=claude-opus-4-8
#
# ⚠️ FABLE 5 — spécificités prises en charge côté code (server/report/anthropicClient.ts) :
#   - REFUS possibles (200 stop_reason:"refusal") sur du contenu clinique bénin :
#     repli AUTOMATIQUE sur claude-opus-4-8 (sinon le CR serait perdu).
#   - Rétention 30 j OBLIGATOIRE (pas de zéro-rétention/ZDR) : à couvrir dans le
#     DPA nLPD avant activation sur du PHI.
#   - Ne pas envoyer budget_tokens/temperature (déjà le cas : thinking adaptatif).
#
# ⚠️ nLPD/FADP : envoyer des pixels d'imagerie (PHI potentiellement brûlé) vers
# Claude (cloud US) exige un consentement/DPA documenté. Tant que ce flag n'est
# pas "true", AI_BACKEND=claude est IGNORÉ et l'analyse retombe sur Ollama local.
MEDIVIEW_CLOUD_AI_PHI_CONSENT=false

# === MOTEURS D'IA CERTIFIÉS tiers (dispositifs médicaux CE/FDA/Swissmedic) ===
# L'IA interne (Claude/Ollama) est une AIDE NON CERTIFIÉE. Pour un diagnostic
# assisté sur lequel le médecin s'appuie cliniquement, brancher un dispositif
# CERTIFIÉ spécialisé. Chacun reste INACTIF tant que son URL+clé ne sont pas
# fournies (CONTRAT commercial requis). Le flag *_PHI_CONSENT garde l'envoi de
# PHI vers le cloud du fournisseur (DPA + nLPD + enregistrement Swissmedic
# obligatoires avant activation — comme pour Claude).
#
# CARPL.ai — marketplace vendor-neutral. RECOMMANDÉ POUR DÉMARRER : permet de
# tester/comparer plusieurs moteurs sur ses propres images avant de s'engager.
# CARPL_URL=
# CARPL_API_KEY=
# CARPL_PHI_CONSENT=false
# Blackford — plateforme agrégeant 90+ apps certifiées (1 intégration → N modèles).
# BLACKFORD_URL=
# BLACKFORD_API_KEY=
# BLACKFORD_PHI_CONSENT=false
# Gleamer BoneView — radio (fractures / MSK), CE.
# GLEAMER_URL=
# GLEAMER_API_KEY=
# GLEAMER_PHI_CONSENT=false
# Koios DS Breast — échographie/mammo mammaire (BI-RADS), CE + FDA.
# KOIOS_URL=
# KOIOS_API_KEY=
# KOIOS_PHI_CONSENT=false
# Aidoc — CT / urgences (AVC, embolie pulmonaire, hémorragie), CE + FDA.
# AIDOC_URL=
# AIDOC_API_KEY=
# AIDOC_PHI_CONSENT=false

# ── Hermès outils enrichis ──────────────────────────────────────────────────

# Group A — Météo + calendrier
# Coordonnées GPS du cabinet pour la météo Open-Meteo (gratuit, pas de clé).
# Genève : 46.2044 / 6.1432 — Lausanne : 46.5197 / 6.6323
CABINET_LAT=46.2044
CABINET_LNG=6.1432

# Google Calendar (service account). Partager le calendrier du médecin en
# lecture avec l'email du service account. Coller le JSON stringifié ici.
# JAMAIS en clair dans git. PHI-safe (calendrier ne contient pas de PHI).
# GOOGLE_SA_KEY_JSON={"type":"service_account","project_id":"..."}
# ID du calendrier à lire (défaut = "primary"). Peut être une adresse email
# de calendrier partagé : ex. cabinet@exemple.com
# GOOGLE_CALENDAR_ID=primary

# Group C — Veille radiologique PubMed
# Clé API NCBI optionnelle. Sans clé : 3 req/s max. Avec clé : 10 req/s.
# Obtenir sur : https://www.ncbi.nlm.nih.gov/account/
# NCBI_API_KEY=
