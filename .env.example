# ----------------------------------------------------------------------------
# Horos Viewer — environment variables
# Copy to `.env` and fill in. `.env` is gitignored.
# ----------------------------------------------------------------------------

# Runtime
NODE_ENV=production
PORT=3000

# Deployment domain (used by Traefik in docker-compose.yml)
HOROS_DOMAIN=horos.example.com

# Auth / sessions ------------------------------------------------------------
# REQUIRED. Secret used to sign session JWTs (HS256). Must be a strong random
# string of at least 16 characters. Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Auth mode: "local" = self-hosted email/password (default). The first account
# registered becomes admin. Set to anything else to use Manus OAuth instead.
AUTH_MODE=local
# Frontend equivalent (must match AUTH_MODE for the login UI to behave).
VITE_AUTH_MODE=local

# Manus OAuth (ONLY if AUTH_MODE != local) -----------------------------------
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# VITE_OAUTH_PORTAL_URL=

# Database (MySQL) -----------------------------------------------------------
# REQUIRED. With docker-compose, host is the `db` service.
# mysql://user:password@host:3306/database
DATABASE_URL=mysql://horos:CHANGE_ME@db:3306/horos
# Used by the bundled MySQL container (docker-compose.yml):
MYSQL_DATABASE=horos
MYSQL_USER=horos
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

# Object storage (S3-compatible / MinIO) -------------------------------------
# REQUIRED to upload/serve DICOM. With docker-compose, endpoint is the `minio`
# service on the internal network.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=horos-dicom
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# Orthanc PACS (optional) ----------------------------------------------------
ORTHANC_URL=http://localhost:8042
ORTHANC_USER=
ORTHANC_PASSWORD=

# SMTP email notifications (optional) ----------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@horos-viewer.com

# Analyse IA d'imagerie ------------------------------------------------------
# Backend : "ollama" (LOCAL, PHI-safe, DÉFAUT) ou "claude" (Anthropic cloud US).
AI_BACKEND=ollama
OLLAMA_URL=http://ollama-hermes:11434
OLLAMA_VISION_MODEL=qwen2.5vl:3b
# Modèle texte Ollama pour le chat « Hermès radiologue » (local, PHI-safe).
OLLAMA_TEXT_MODEL=qwen2.5:3b
# Modèle d'embeddings Ollama pour la base de connaissances Hermès (local, PHI-safe).
OLLAMA_EMBED_MODEL=nomic-embed-text
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
#
# ⚠️ nLPD/FADP : envoyer des pixels d'imagerie (PHI potentiellement brûlé) vers
# Claude (cloud US) exige un consentement/DPA documenté. Tant que ce flag n'est
# pas "true", AI_BACKEND=claude est IGNORÉ et l'analyse retombe sur Ollama local.
MEDIVIEW_CLOUD_AI_PHI_CONSENT=false
