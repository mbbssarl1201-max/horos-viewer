# MediView on-premise — modèle de configuration.
# Copie en .env puis lance ./setup.sh (qui génère les secrets automatiquement),
# OU remplis manuellement les valeurs <A_GENERER> avec des secrets forts.
# NE JAMAIS versionner le .env (il est gitignoré).

# ── Image applicative ────────────────────────────────────────────────────────
# SHA de l'image déployée (voir README pour récupérer le dernier). `self-host`
# pointe toujours sur la dernière version, mais épingler un SHA est plus sûr.
MEDIVIEW_IMAGE_TAG=self-host

# ── Accès clinique (LAN) ─────────────────────────────────────────────────────
# Nom d'hôte interne servi en HTTPS (TLS interne Caddy). À résoudre vers l'IP
# LAN de cette machine (DNS local ou fichier hosts des postes du cabinet).
MEDIVIEW_HOSTNAME=mediview.cabinet.local

# ── Base de données MySQL ────────────────────────────────────────────────────
MYSQL_DATABASE=mediview
MYSQL_USER=mediview
MYSQL_PASSWORD=<A_GENERER>
MYSQL_ROOT_PASSWORD=<A_GENERER>
# Construit à partir des valeurs ci-dessus (setup.sh le génère pour toi) :
DATABASE_URL=mysql://mediview:<A_GENERER>@db:3306/mediview

# ── Sécurité application ─────────────────────────────────────────────────────
# ≥ 32 caractères (l'app refuse de démarrer sinon).
JWT_SECRET=<A_GENERER>

# ── Stockage objet (MinIO) ───────────────────────────────────────────────────
S3_REGION=us-east-1
S3_BUCKET=mediview
S3_ACCESS_KEY=<A_GENERER>
S3_SECRET_KEY=<A_GENERER>

# ── Pont PACS (Orthanc → dcm4chee du cabinet) ────────────────────────────────
ORTHANC_USER=mediview
ORTHANC_PASSWORD=<A_GENERER>
# Coordonnées du PACS du cabinet (déjà validées : C-ECHO/C-FIND OK).
DCM4CHEE_AET=DCM4CHEE
DCM4CHEE_HOST=192.168.1.180
DCM4CHEE_PORT=11112

# ── IA locale ────────────────────────────────────────────────────────────────
# Avec GPU : qwen2.5vl:7b (meilleure qualité). Sans GPU : qwen2.5vl:3b (rapide
# mais qualité moindre). Le modèle est téléchargé au 1er démarrage (setup.sh).
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# ── SMTP (optionnel : envoi des comptes rendus au confrère) ──────────────────
# Laisser vide si l'envoi par email n'est pas utilisé.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=mediview@cabinet.local
