# Reverse proxy + HTTPS interne pour l'accès clinique sur le LAN.
# `tls internal` : Caddy génère une autorité de certification locale et un
# certificat pour le nom d'hôte. Aucune connexion Internet requise.
# (Voir README §HTTPS pour faire confiance à la CA sur les postes du cabinet.)

{$MEDIVIEW_HOSTNAME} {
	tls internal

	# Compression du transfert : le DICOM CT non compressé se réduit nettement
	# (≈ ×2) → chargement plus rapide. Le navigateur décompresse de façon
	# transparente, Cornerstone reçoit les octets complets.
	encode zstd gzip

	# Les imports DICOM (fichiers volumineux encodés en base64 dans tRPC) peuvent
	# être lourds — on relève la limite de taille du corps de requête.
	request_body {
		max_size 4GB
	}

	reverse_proxy app:3000
}
